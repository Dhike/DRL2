DRL_ENVIRONMENT=development
DRL_CORS_ORIGINS=["http://localhost:3000"]
DRL_DATABASE_URL=postgresql+psycopg:///drl2
DRL_JWT_SECRET=replace-with-a-long-random-value
DRL_EMAIL_BACKEND=console
DRL_EMAIL_FROM=DRL2 <no-reply@localhost>
DRL_SMTP_HOST=
DRL_SMTP_PORT=587
DRL_SMTP_USERNAME=
DRL_SMTP_PASSWORD=
DRL_SMTP_USE_STARTTLS=true
DRL_MARKET_PROVIDER=gate
